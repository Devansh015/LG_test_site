# Local preview needs no credentials. Copy to .env.local when connecting services.
# Set only when a verified production domain exists; enables indexing and canonical URLs.
SITE_URL=

# Notification delivery (server only). Verified sending domain is required by Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Distributed production rate limiting. Required when enabling real submissions in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 bytes; never NEXT_PUBLIC.
RATE_LIMIT_SALT=
# Set true only behind a trusted reverse proxy that overwrites x-real-ip.
TRUST_PROXY=false
# For isolated local production-mode form testing only. Never use for a public deployment.
ALLOW_LOCAL_TEST_FORMS=

# Optional published-content CMS. Public dataset contains business content only, never enquiries.
SANITY_PROJECT_ID=
SANITY_DATASET=production
